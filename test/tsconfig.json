{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"composite": false,
		"rootDir": "../",
		"types": ["node"],
	},
	// The suite imports the BUILT package (`'../dist/...'` -- build first: `npm run build:all`), so the types
	// come from `dist/**/*.d.ts` through those imports and `src` is deliberately NOT in this program: a src
	// type error is the build's to report, not a test run's.
	"include": [
		"*.ts",
	]
}
