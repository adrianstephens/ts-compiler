{
	"compilerOptions": {
		"composite": true,
		"target": "ES2023",
		"module": "commonjs",
		"strict": true,
		"declaration": true,
		"stripInternal": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"types": ["node"],
		"paths": {
			"@isopodlabs/tison/tableCache": ["../tison/dist/tableCache"],
			"@isopodlabs/tison/rrule": ["../tison/dist/rrule"],
			"@isopodlabs/tison/ast": ["../tison/dist/ast"],
			"@isopodlabs/tison/walker": ["../tison/dist/walker"],
			"@isopodlabs/binary_libs/wasm": ["../binary-libs/dist/wasm"]
		}
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		// Real TS syntax, but deliberately not standalone-valid TypeScript (e.g. `static` members
		// referencing the class's own type parameter, `this[i]` with no index signature) -- wasm-backend.ts
		// reads this file's own text and reparses it with `TS.parse` for codegen, it's never `import`ed
		// as a normal module. Matches `test/tsconfig.json`'s own exclusion.
		"src/ts/lib/**/*.ts"
	],
	"references": [
		{"path": "../tison"}
	]
}
